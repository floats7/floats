# Robinhood Chain Mainnet
APP_ENV=mainnet
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
RPC_INDEXER=https://rpc.mainnet.chain.robinhood.com
BLOCK_EXPLORER_URL=https://robinhoodchain.blockscout.com
INDEXER_START_BLOCK=
INDEXER_CONFIRMATIONS=24
INDEXER_BATCH_SIZE=500
INDEXER_REORG_REPLAY_DEPTH=128
INDEXER_MAX_CATCH_UP_CYCLES=100

# Server-only Supabase configuration; never expose these values to browser code
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Governance and operations
ADMIN_ADDRESS=
GUARDIAN_ADDRESS=
KEEPER_ADDRESS=
TREASURY_ADDRESS=
TIMELOCK_DELAY_SECONDS=300
DEPLOYER_PRIVATE_KEY=
DEPLOYMENT_VERSION=0.2.0
INITIAL_TVL_CAP=250000000000
MANAGEMENT_FEE_BPS=0
CASH_FEE_BPS=0
IN_KIND_FEE_BPS=0
OFF_HOURS_FEE_BPS=0
CANARY_USDG_AMOUNT=1000000

# Canonical address confirmed by official documentation and RPC bytecode check
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
USDG_DECIMALS=6

# Protocol addresses are populated only after deployment verification
FLOATS_VAULT_ADDRESS=
INDEX_REGISTRY_ADDRESS=
NAV_ORACLE_ADDRESS=
SWAP_QUOTE_ORACLE_ADDRESS=
SWAP_ADAPTER_ADDRESS=
REBALANCER_ADDRESS=
FEE_MODULE_ADDRESS=
TIMELOCK_ADDRESS=
