{
  "name": "floats",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:public": "node --experimental-transform-types scripts/check-public-repo.ts",
    "test:api": "node --experimental-transform-types --test apps/api/test/**/*.test.ts",
    "test:indexer": "node --experimental-transform-types --test apps/indexer/test/**/*.test.ts",
    "test:keeper": "node --experimental-transform-types --test apps/keeper/test/**/*.test.ts",
    "test:pricer": "node --experimental-transform-types --test apps/pricer/test/**/*.test.ts",
    "test:signer": "node --experimental-transform-types --test apps/signer/test/**/*.test.ts",
    "test:database": "node --experimental-transform-types --test packages/database/test/**/*.test.ts",
    "test:crosschain": "node --experimental-transform-types --test packages/crosschain/test/**/*.test.ts",
    "test:web": "node --experimental-transform-types --test apps/web/test/**/*.test.ts",
    "test:differential": "node --experimental-transform-types scripts/differential-core-model.ts",
    "quality:contracts": "forge fmt --check && forge lint contracts/src --severity high --severity med && forge test --no-match-path 'contracts/test/CoreTestnetFork.t.sol'",
    "coverage:contracts": "forge coverage --report summary --no-match-path 'contracts/test/CoreTestnetFork.t.sol'",
    "snapshot:contracts": "forge snapshot --no-match-path 'contracts/test/CoreTestnetFork.t.sol'",
    "start:api": "node --experimental-transform-types apps/api/src/server.ts",
    "start:indexer": "node --experimental-transform-types apps/indexer/src/worker.ts",
    "start:indexer:crosschain": "node --experimental-transform-types apps/indexer/src/crosschain-worker.ts",
    "start:keeper": "node --experimental-transform-types apps/keeper/src/worker.ts",
    "start:operations": "node --experimental-transform-types apps/operations/src/worker.ts",
    "start:signer": "node --experimental-transform-types apps/signer/src/server.ts",
    "start:pricer": "node --experimental-transform-types apps/pricer/src/server.ts",
    "migrate:supabase": "node --experimental-transform-types scripts/apply-supabase-migrations.ts",
    "generate:deployment-manifest": "node --experimental-transform-types scripts/generate-deployment-manifest.ts",
    "generate:crosschain-manifest": "node --experimental-transform-types scripts/generate-crosschain-manifest.ts",
    "generate:crosschain-activation": "node --experimental-transform-types scripts/generate-crosschain-activation-batch.ts",
    "indexer:catch-up": "node --experimental-transform-types scripts/catch-up-indexer.ts",
    "indexer:inspect": "node --experimental-transform-types scripts/inspect-indexer-state.ts",
    "reconcile:nav": "node --experimental-transform-types scripts/reconcile-nav.ts",
    "verify:core-activation": "node --experimental-transform-types scripts/verify-core-activation.ts",
    "verify:deployment": "node --experimental-transform-types scripts/verify-deployment.ts",
    "verify:options-deployment": "node --experimental-transform-types scripts/verify-options-deployment.ts",
    "verify:layerzero-network": "node --experimental-transform-types scripts/verify-layerzero-network.ts",
    "verify:layerzero-pathway": "node --experimental-transform-types scripts/verify-layerzero-pathway.ts",
    "wire:layerzero-peer": "node --experimental-transform-types scripts/wire-layerzero-peer.ts",
    "configure:layerzero-pathway": "node --experimental-transform-types scripts/configure-layerzero-pathway.ts",
    "inspect:token-capabilities": "node --experimental-transform-types scripts/inspect-token-capabilities.ts",
    "prepare:options-secrets": "node --experimental-transform-types scripts/prepare-options-secrets.ts",
    "record:options-addresses": "node --experimental-transform-types scripts/update-options-addresses.ts",
    "configure:railway-options": "node --experimental-transform-types scripts/configure-railway-options.ts",
    "configure:railway-core": "node --experimental-transform-types scripts/configure-railway-core.ts",
    "validate:options-expiry": "node --experimental-transform-types scripts/validate-options-expiry.ts",
    "import:market-candidates": "node --experimental-transform-types scripts/import-market-candidates.ts",
    "sync:rhj-candidates": "node --experimental-transform-types scripts/sync-rhj-market-candidates.ts",
    "verify:market-candidates": "node --experimental-transform-types scripts/verify-market-candidates.ts",
    "control:market-candidate-product": "node --experimental-transform-types scripts/set-market-candidate-product-pause.ts",
    "acknowledge:market-candidate-alert": "node --experimental-transform-types scripts/acknowledge-market-candidate-alert.ts",
    "prepare:market-candidate-announcement": "node --experimental-transform-types scripts/prepare-market-candidate-announcement.ts",
    "record:market-candidate-signoff": "node --experimental-transform-types scripts/record-market-candidate-signoff.ts",
    "seed:options-testnet": "node --experimental-transform-types scripts/seed-options-testnet.ts"
  },
  "dependencies": {
    "@layerzerolabs/lz-evm-messagelib-v2": "3.0.168",
    "@layerzerolabs/lz-evm-protocol-v2": "3.0.168",
    "@layerzerolabs/oapp-evm": "0.4.1",
    "@layerzerolabs/oft-evm": "4.0.1",
    "@openzeppelin/contracts": "5.7.0",
    "@openzeppelin/contracts-upgradeable": "5.7.0",
    "pg": "^8.16.3",
    "solidity-bytes-utils": "0.8.4",
    "viem": "2.58.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "^8.15.6",
    "railway": "^3.17.0",
    "supabase": "^3.2.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "ws": "8.23.0"
  }
}
